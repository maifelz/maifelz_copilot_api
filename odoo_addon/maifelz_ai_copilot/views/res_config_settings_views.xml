<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_maifelz" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.maifelz</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="mAifelZ AI Copilot" string="mAifelZ AI Copilot" name="maifelz_ai_copilot">
                    <block title="mAifelZ AI Cloud Bridge Configuration" id="maifelz_settings_block">
                        <setting id="mfz_license_box" string="Enterprise Cloud Subscription" help="Connect this Odoo database to your mAifelZ Cloud AI subscription. Users log in separately at copilot.maifelz.com.">
                            <field name="mfz_is_active" invisible="1"/>
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="mfz_license_key" class="col-lg-3 o_light_label" string="License Key"/>
                                    <div class="col-lg-9">
                                        <field name="mfz_license_key" placeholder="MFZ-PRO-2026-XXXX" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <label for="mfz_copilot_server_url" class="col-lg-3 o_light_label" string="mAifelZ Server"/>
                                    <div class="col-lg-9">
                                        <field name="mfz_copilot_server_url" class="w-100"/>
                                    </div>
                                </div>
                                <div class="mt-3 d-flex gap-2">
                                    <button name="action_verify_license" type="object" string="Verify &amp; Connect to mAifelZ Cloud" class="btn btn-primary" icon="fa-check-circle"/>
                                    <button name="action_open_copilot_portal" type="object" string="Launch mAifelZ AI Portal" class="btn btn-secondary" icon="fa-external-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_maifelz_config_settings" model="ir.actions.act_window">
        <field name="name">mAifelZ AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'maifelz_ai_copilot'}</field>
    </record>
</odoo>
